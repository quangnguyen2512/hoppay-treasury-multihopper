# Environment mode: demo | devnet | mainnet
# In `demo` mode, HopPay simulates the exact MultiHopper on-chain fee schedule locally (0 keys needed).
# Switch to `devnet` with mh_test_... or `mainnet` with mh_live_... for live Solana routing.
MULTIHOPPER_ENV=demo
MULTIHOPPER_API_KEY=
MULTIHOPPER_WEBHOOK_SECRET=whsec_dev_local_change_me

# Operator admin key protecting mutating treasury endpoints (REQUIRED for public live deployments)
# Leave blank only for local demo testing. Send via header `x-hoppay-admin-key` or `Authorization: Bearer ...`
HOPPAY_ADMIN_TOKEN=

# Solana JSON-RPC used by the browser wallet broadcaster & CLI signers
SOLANA_RPC_URL=https://api.devnet.solana.com

# Treasury policy guardrails
HOPPAY_MAX_SINGLE_RECIPIENT_USD=10000
HOPPAY_APPROVAL_THRESHOLD_USD=2500
HOPPAY_DB_PATH=./data/hoppay.db
